{
  "manifest_version": 3,
  "name": "Cortex",
  "version": "0.2.0",
  "description": "Lets a Cortex agent work in your current Chrome tab when you ask it to. You approve final actions.",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Cortex"}
}
