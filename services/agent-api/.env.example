# The control plane binds to loopback unless explicitly overridden.
CORTEX_AGENT_API_TOKEN=replace-with-a-long-local-random-token
DATABASE_URL=postgresql://cortex:cortex@127.0.0.1:54329/cortex_agent
CORTEX_AGENT_DATA_DIR=.data
CORTEX_AGENT_DOCKER_IMAGE=cortex-agent-worker:local
CORTEX_AGENT_MODEL_MODE=fake
# Interactive CLI: export both of these before `uv run cortex-agent`.
# OPENROUTER_API_KEY=your-key
# OPENROUTER_MODEL=provider/model-id
# The CLI starts its own local manager configured for OpenRouter, so exports take effect immediately.
# A separately started HTTP service can also use CORTEX_AGENT_MODEL_MODE=openrouter for workflow=agent.
# For a real model, set MODEL_MODE=openai and these values. They are never put in task data.
# CORTEX_AGENT_OPENAI_API_KEY=
# CORTEX_AGENT_OPENAI_MODEL=gpt-4.1-mini
# For real web search, set SEARCH_MODE=tavily and this key.
# CORTEX_AGENT_TAVILY_API_KEY=
CORTEX_AGENT_SEARCH_MODE=fake
# off | metadata | redacted. Content export is opt-in; tracing does not run by default.
CORTEX_AGENT_TRACE_MODE=off
# Optional only when trace mode is enabled.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=cortex-agent-api
